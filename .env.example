# Optional. Without it queryforge runs rule-derived candidates and index
# experiments only — which still found every planted defect in the benchmark.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# The database being optimised. Point this at a REPLICA: index experiments
# briefly take an exclusive lock on the table they build against.
TARGET_DSN=postgres://queryforge:queryforge@localhost:5434/shop?sslmode=disable

# MySQL is supported for everything except index experiments. Start it with
#   docker compose -f deploy/docker-compose.yml --profile mysql up -d mysql
# and point TARGET_DSN at it:
#   TARGET_DSN=queryforge:queryforge@tcp(127.0.0.1:3307)/shop
#
# The dialect is inferred from the DSN shape. Set this only when that fails.
TARGET_DIALECT=

# queryforge's own database: jobs and measurement history.
METADATA_DSN=postgres://queryforge:queryforge@localhost:5434/queryforge?sslmode=disable

# Measurement. Fewer than 3 runs has no meaningful median and is rejected at
# startup; the warm-up run is discarded so cold caches do not flatter a rewrite.
MEASUREMENT_RUNS=5
WARMUP_RUNS=1

# A rewrite must beat this, AND beat the run-to-run spread of the measurements.
MIN_IMPROVEMENT_PCT=10

QUERY_TIMEOUT=30s
MAX_CANDIDATES=4
MAX_INDEX_TESTS=3
TEST_INDEXES=true
